            <chunk name="Object" index="903">
              <items count="2">
                <item name="GUID" type_name="gh_guid" type_code="9">1e9e08fc-c31e-49eb-a36c-90de5e62e5f5</item>
                <item name="Name" type_name="gh_string" type_code="10">VB Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="6">
                    <item name="Description" type_name="gh_string" type_code="10">A VB.NET scriptable component</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">d6fe37b1-0fc2-4541-984f-a6276ec19b6c</item>
                    <item name="Name" type_name="gh_string" type_code="10">VB Script</item>
                    <item name="NickName" type_name="gh_string" type_code="10">VB</item>
                    <item name="ReferenceCount" type_name="gh_int32" type_code="3">0</item>
                    <item name="ScriptSource" type_name="gh_string" type_code="10">    If (C Is Nothing) Then Return
    If (N &lt;= 0) Then Return

    If (Not C.IsClosed()) Then
      Print("Your input curve is not closed.")
      Return
    End If

    Dim bbox As BoundingBox = C.GetBoundingBox(False)
    Dim U As New Interval(bbox.Min.X, bbox.Max.X)
    Dim V As New Interval(bbox.Min.Y, bbox.Max.Y)

    Dim rnd As New Random(rand)

    Dim circles As New List(Of Circle)
    For Each cir As Circle In PreCircles
      circles.Add(cir)
    Next
    Dim attempts As Int32 = 0

    Do While (attempts &lt; 10000)
      attempts += 1

      Dim radius As Double = R(rnd.Next(R.Count))
      Dim point As New Point3d(U.ParameterAt(rnd.NextDouble()), V.ParameterAt(rnd.NextDouble()), 0)

      If (C.Contains(point, Plane.WorldXY) &lt;&gt; Rhino.Geometry.PointContainment.Inside) Then Continue Do
      Dim ct As Double
      C.ClosestPoint(point, ct)
      Dim cp As Point3d = C.PointAt(ct)

      If (point.DistanceTo(cp) &lt; radius + distfront) Then Continue Do

      For Each crc As Circle In circles
        If (point.DistanceTo(crc.Center) &lt;= (crc.Radius + radius + interdist)) Then Continue Do
      Next

      Dim circle As New Circle(point, radius)
      circles.add(circle)
      If (circles.Count &gt;= N) Then Exit Do
      attempts = 0
    Loop

    A = circles</item>
                  </items>
